{
  "name": "claude-codex-orch",
  "version": "0.1.1",
  "description": "Local orchestrator that routes coding tasks between Claude Code and Codex and fails over on rate limit or failure",
  "keywords": [
    "claude-code",
    "codex",
    "orchestrator",
    "mcp",
    "cli",
    "agent"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "orch": "dist/cli/index.js",
    "orch-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "config.example.yaml",
    "README.md",
    "LICENSE",
    "docs/USAGE.th.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
