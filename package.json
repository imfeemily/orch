{
  "name": "claude-codex-orch",
  "version": "0.2.1",
  "description": "Local orchestrator that routes coding tasks between Claude Code and Codex and fails over on rate limit or failure",
  "keywords": [
    "claude-code",
    "codex",
    "orchestrator",
    "mcp",
    "cli",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imfeemily/orch.git"
  },
  "homepage": "https://imfeemily.github.io/orch/",
  "bugs": {
    "url": "https://github.com/imfeemily/orch/issues"
  },
  "type": "module",
  "bin": {
    "orch": "dist/cli/index.js",
    "orch-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "config.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "docs:gen": "tsx scripts/gen-reference.ts",
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4"
  }
}
